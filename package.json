{
  "name": "mach-report",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "独立的 TypeScript 报表引擎与 Vue 3 预览组件",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json && vue-tsc --noEmit -p packages/mach-report && vue-tsc --noEmit -p packages/federation",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "changeset": "changeset",
    "version": "changeset version",
    "clean": "pnpm -r --if-present run clean",
    "release": "pnpm changeset version && pnpm install && pnpm build && pnpm test && pnpm changeset publish",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.8.9",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
