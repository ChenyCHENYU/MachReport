{
  "name": "mach-report",
  "version": "0.0.1",
  "private": true,
  "description": "面向 B 端打印报表的高性能 TypeScript 报表引擎（兼容 jh4j-cloud-report 契约）",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json && vue-tsc --noEmit -p packages/vue/tsconfig.json && vue-tsc --noEmit -p packages/federation/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "changeset": "changeset",
    "version": "changeset version",
    "capture:gridplan": "node scripts/fetch-gridplan.mjs",
    "clean": "pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^17.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
