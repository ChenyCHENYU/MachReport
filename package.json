{
  "name": "mach-report",
  "version": "0.0.1",
  "private": true,
  "description": "面向 B 端打印报表的高性能 TypeScript 报表引擎（兼容 jh4j-cloud-report 契约）",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json",
    "clean": "pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "happy-dom": "^17.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.42"
  }
}
