{
  "name": "@agile-team/mach-report",
  "version": "2.10.0",
  "description": "独立的 TypeScript 报表引擎：模板分页、DOM/Canvas/PDF/Excel 输出与 Vue 3 预览组件",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pdf": "./src/pdf.ts",
    "./sql": "./src/sql.ts",
    "./vue": "./src/vue/index.ts",
    "./vue/async": "./src/vue/async.ts",
    "./vue/style.css": "./src/vue/style.css",
    "./xlsx": "./src/xlsx.ts",
    "./server": "./src/server.ts",
    "./designer": "./src/designer.ts",
    "./xlsx/node": "./src/xlsx/node.ts",
    "./analytics": "./src/analytics.ts",
    "./worker": "./src/worker.ts",
    "./server/node": "./src/server/node.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./pdf": {
        "import": {
          "types": "./dist/pdf.d.ts",
          "default": "./dist/pdf.js"
        },
        "require": {
          "types": "./dist/pdf.d.cts",
          "default": "./dist/pdf.cjs"
        }
      },
      "./sql": {
        "import": {
          "types": "./dist/sql.d.ts",
          "default": "./dist/sql.js"
        },
        "require": {
          "types": "./dist/sql.d.cts",
          "default": "./dist/sql.cjs"
        }
      },
      "./vue": {
        "import": {
          "types": "./dist/vue/index.d.ts",
          "default": "./dist/vue.js"
        },
        "require": {
          "types": "./dist/vue/index.d.cts",
          "default": "./dist/vue.cjs"
        }
      },
      "./vue/async": {
        "import": {
          "types": "./dist/vue/async.d.ts",
          "default": "./dist/vue-async.js"
        },
        "require": {
          "types": "./dist/vue/async.d.cts",
          "default": "./dist/vue-async.cjs"
        }
      },
      "./vue/style.css": "./dist/style.css",
      "./xlsx": {
        "import": {
          "types": "./dist/xlsx.d.ts",
          "default": "./dist/xlsx.js"
        },
        "require": {
          "types": "./dist/xlsx.d.cts",
          "default": "./dist/xlsx.cjs"
        }
      },
      "./server": {
        "import": {
          "types": "./dist/server.d.ts",
          "default": "./dist/server.js"
        },
        "require": {
          "types": "./dist/server.d.cts",
          "default": "./dist/server.cjs"
        }
      },
      "./designer": {
        "import": {
          "types": "./dist/designer.d.ts",
          "default": "./dist/designer.js"
        },
        "require": {
          "types": "./dist/designer.d.cts",
          "default": "./dist/designer.cjs"
        }
      },
      "./xlsx/node": {
        "import": {
          "types": "./dist/xlsx/node.d.ts",
          "default": "./dist/xlsx-node.js"
        },
        "require": {
          "types": "./dist/xlsx/node.d.cts",
          "default": "./dist/xlsx-node.cjs"
        }
      },
      "./analytics": {
        "import": {
          "types": "./dist/analytics.d.ts",
          "default": "./dist/analytics.js"
        },
        "require": {
          "types": "./dist/analytics.d.cts",
          "default": "./dist/analytics.cjs"
        }
      },
      "./worker": {
        "import": {
          "types": "./dist/worker.d.ts",
          "default": "./dist/worker.js"
        },
        "require": {
          "types": "./dist/worker.d.cts",
          "default": "./dist/worker.cjs"
        }
      },
      "./server/node": {
        "import": {
          "types": "./dist/server/node.d.ts",
          "default": "./dist/server-node.js"
        },
        "require": {
          "types": "./dist/server/node.d.cts",
          "default": "./dist/server-node.cjs"
        }
      }
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "LICENSING.md"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.node.config.ts && node scripts/copy-dcts.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node scripts/sync-readme.mjs"
  },
  "peerDependencies": {
    "vue": "^3.2.47"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/node": "^22.12.0"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.0",
    "exceljs": "^4.4.0",
    "node-sql-parser": "^5.4.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "ChenyCHENYU (Agile Team)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/MachReport.git",
    "directory": "packages/mach-report"
  },
  "homepage": "https://github.com/ChenyCHENYU/MachReport#readme",
  "bugs": {
    "url": "https://github.com/ChenyCHENYU/MachReport/issues"
  }
}
