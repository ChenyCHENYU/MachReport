{
  "name": "@agile-team/mach-report",
  "version": "0.4.0",
  "description": "MachReport 报表引擎单包：RenderPlan 模型 + 分页 + DOM/Canvas/PDF 渲染 + 动态 SQL + 管理端 API（框架无关、零运行时依赖、子路径按需引入）",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pdf": "./src/pdf.ts",
    "./sql": "./src/sql.ts",
    "./manager": "./src/manager.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
        "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
      },
      "./pdf": {
        "import": { "types": "./dist/pdf.d.ts", "default": "./dist/pdf.js" },
        "require": { "types": "./dist/pdf.d.cts", "default": "./dist/pdf.cjs" }
      },
      "./sql": {
        "import": { "types": "./dist/sql.d.ts", "default": "./dist/sql.js" },
        "require": { "types": "./dist/sql.d.cts", "default": "./dist/sql.cjs" }
      },
      "./manager": {
        "import": { "types": "./dist/manager.d.ts", "default": "./dist/manager.js" },
        "require": { "types": "./dist/manager.d.cts", "default": "./dist/manager.cjs" }
      }
    }
  },
  "engines": { "node": ">=18.0.0" },
  "files": ["dist"],
  "scripts": {
    "build": "tsup && node scripts/copy-dcts.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "node-sql-parser": "^5.4.0",
    "pdf-lib": "^1.17.1",
    "tsup": "^8.0.0"
  }
}
