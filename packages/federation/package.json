{
  "name": "@agile-team/mach-report-federation",
  "version": "0.1.0",
  "description": "MachReport 模块联邦远程入口，供需要远程加载报表组件的项目使用",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./reportPreview": "./src/reportPreview.vue",
    "./reportHtmlPreview": "./src/reportHtmlPreview.vue",
    "./filePreview": "./src/filePreview.vue"
  },
  "scripts": {
    "build": "vite build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agile-team/mach-report": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.3.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.0",
    "vite": "^7.3.6",
    "vue": "^3.5.0"
  }
}
