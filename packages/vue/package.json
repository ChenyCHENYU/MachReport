{
  "name": "@agile-team/mach-report-vue",
  "version": "0.2.0",
  "description": "MachReport Vue 3 适配单包：契约兼容 jh4j reportPreview 的预览组件 + 插件（安装这一个包即可，自动携带引擎）",
  "type": "module",
  "sideEffects": ["*.css", "*.vue"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/style.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./style.css": "./dist/style.css"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agile-team/mach-report": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
